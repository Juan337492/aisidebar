{
  "name": "aisidebar-companion",
  "version": "0.1.0",
  "type": "module",
  "description": "Local helper for the AI Sidebar browser extension: chat with Claude and Gemini using your own Claude and Google sign-ins.",
  "bin": {
    "aisidebar-companion": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts start",
    "token": "node --disable-warning=ExperimentalWarning src/cli.ts token",
    "install-service": "node --disable-warning=ExperimentalWarning src/cli.ts install",
    "uninstall-service": "node --disable-warning=ExperimentalWarning src/cli.ts uninstall",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juan337492/aisidebar.git",
    "directory": "companion"
  },
  "homepage": "https://github.com/Juan337492/aisidebar#readme",
  "bugs": {
    "url": "https://github.com/Juan337492/aisidebar/issues"
  },
  "keywords": [
    "claude",
    "gemini",
    "antigravity",
    "firefox",
    "chrome",
    "sidebar",
    "extension"
  ]
}
